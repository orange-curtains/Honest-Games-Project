---
import MainLayout from "../layouts/mainLayout.astro";

import heroLogoDesktop from "../assets/logo/HG-Logo-Main.svg";
import heroLogoMobile from "../assets/logo/HG-Logo-Centered-Mobile.svg";
import chalkBoardUser from "../assets/icons/chalkboard-user-solid-white.png";
import gamepad from "../assets/icons/gamepad-solid-white.png";
import megaphone from "../assets/icons/bullhorn-solid-white.png";
import rexSticker from "../assets/media/rex-sticker.png";
import racoonSticker from "../assets/media/racoon-sticker.png";


import Home3UpBox from "../components/home3UpBox.astro";
import HomeInfoCarouselContainer from "../components/homeInfoCarouselContainer.astro";

import "../styles/global.css";
---

<style>
    #takeActionModule {
        background: linear-gradient(
            180deg,
            rgba(53, 80, 206, 1) 85%,
            rgba(255, 250, 250, 1) 85%
        );
    }

    #takeActionModule::before {
        content: ""; /* Required for the pseudo-element to exist */
        top: 30%;
        left: 0;
        position: absolute;
        width: 100%;
        height: 500px;
        background-image: url("/assets/game-background-texture-top.svg");
        background-size: cover;
        background-repeat: no-repeat;
        background-position: top;
        z-index: -1;
    }

    #educatorModule::after {
        content: ""; /* Required for the pseudo-element to exist */
        background-image: url("/assets/rex-racoon-stickers.png  ");
        width: 25rem;
        height: 25rem;
        position: absolute;
        background-repeat: no-repeat;
        background-size: 25rem;
        left: 65%;
        bottom: -25%;
        overflow: hidden;
    }
    @media screen and (max-width: 1024px) {
        #educatorModule::after {
            display: none;
        }
    }
</style>

<MainLayout metaTitle="Home" metaDescription="">
    <main>
        <div
            id="hero"
            style={{ backgroundImage: `url(/assets/hero-illustration.png)` }}
            class="min-h-1000 bg-size-[50rem] bg-no-repeat bg-position-[100%_100%] sm:min-h-100vh md:bg-position-center lg:min-h-850 lg:bg-position-center 2xl:bg-size-[50%]"
        >
            <div id="heroText" class="lg:pl-200 pt-50">
                <h1 class="upperCase pb-30">
                    <img
                        id="desktopHero"
                        class="hidden max-w-600 lg:block"
                        src={heroLogoDesktop.src}
                        alt="The Honest Games Project"
                    />
                    <img
                        id="mobileHero"
                        class="w-max-400 py-10 sm:max-w-300 md:max-w-[50%] mx-auto lg:hidden"
                        src={heroLogoMobile.src}
                        alt="The Honest Games Project"
                    />
                    <!--
                            <span>The</span> <span>Honest</span><span> Games <img src="media/HG-heart-icon.png" /></span>
                            <span>Project</span>
                            -->
                </h1>
                <p
                    class="text-center text-bodySubHead max-w-400 px-20 mx-auto md:max-w-600 lg:mx-0 lg:text-left lg:text-lgBodySubHead lg:max-w-800 lg:px-0 lg:pb-50"
                >
                    Let’s create a world of fun and fair games together. Leave
                    the manipulative marketing behind and support honest play.
                </p>
                <p
                    class="text-center font-accent text-triggerBrand text-bodyCopy pt-20 animate-pulsate lg:text-left lg:text-[3rem] lowercase"
                >
                    Keep scrolling<span> &#62;</span>
                </p>
            </div>
        </div>
        <!--Take Action Module-->
        <div
            class="flex justify-center relative isolate mb-100"
            id="takeActionModule"
        >
            <div id="takeActionContainer" class="max-w-full">
                <h2
                    class="uppercase text-center text-secondaryBrand text-heroHead font-bold pt-50"
                >
                    Take Action
                </h2>
                <ul
                    class="flex gap-20 mt-60 overflow-x-auto overflow-y-hidden snap-x snap-mandatory lg:overflow-x-hidden"
                    id="takeAction3up"
                >
                    <!-- Take Action Info Box 1-->
                    <Home3UpBox
                        threeUpBoxLink="index.html"
                        threeUpBoxTitle="Get Informed"
                        threeUpBoxText="From mobile games to AAA titles, video games are using shady sales tactics to separate people from their hard-earned money."
                        threeUpBoxImage={chalkBoardUser.src}
                    />
                    <Home3UpBox
                        threeUpBoxLink="/under-construction"
                        threeUpBoxTitle="Test your Game"
                        threeUpBoxText="Use the deceptive patterns calculator tool to discover if the games you love are subtly pushing you to spend more money."
                        threeUpBoxImage={gamepad.src}
                    />
                    <Home3UpBox
                        threeUpBoxLink="/under-construction"
                        threeUpBoxTitle="Spread the Word"
                        threeUpBoxText="Don’t let your friends and family fall for the same traps. Learn the signs and start the conversation. Share these resources with friends."
                        threeUpBoxImage={megaphone.src}
                    />
                </ul>
            </div>
        </div>

        <!--Decpetive Patterns Module-->
        <div
            class="pb-70"
            style="background: url(assets/game-background-texture-cropped.svg),
            linear-gradient(0deg, rgba(53, 80, 206, 1) 55%, rgba(255, 250, 250, 1) 55%);"
            id="deceptivePatternsModule"
        >
            <h2
                class="uppercase font-extrabold text-[4.5rem]/[4.5rem] text-center text-mainBrand pb-20 lg:text-[6.5rem]/[6.5rem] lg:pb-30"
            >
                Deceptive Patterns Defined
            </h2>
            <p
                class="text-[2rem]/[3.2rem] text-center pb-50 max-w-[85%] m-auto lg:max-w-1000 lg:text-[2.5rem]/[4.5rem] lg:pb-70"
                id="deceptivePatternsModuleIntroText"
            >
                Deceptive patterns are design choices in websites, apps, and
                video games used to intentionally manipulate users into taking
                actions they otherwise would not. Fromloot boxes to time-limited
                sales, deceptive patterns in video games actively push users to
                spend more time and money in the game.
            </p>
            <div
                class="max-w-[85%] m-auto shadow-[3px_3px_25px_0_rgba(0,0,0,0.15)] lg:max-w-1080"
                id="DeceptivePatternsInfoContainer"
            >
                <div
                    class="bg-triggerBrand px-20 py-25 rounded-t-[10px] lg:px-40 lg:py-75"
                    id="DeceptivePatternsInfoContainerHeader"
                >
                    <h2
                        class="flex flex-wrap items-center justify-center font-accent text-center text-secondaryBrand m-auto lg:flex-nowrap lg:text-left lg:gap-20 lg:w-full"
                    >
                        <span class="lg:text-[10rem]/[10rem]">30+</span>
                        <span
                            class="text-[2rem]/[3.4rem] lg:text-[4.5rem]/[5.5rem] lg:max-w-700"
                        >
                            documented deceptive patterns in video games</span
                        >
                    </h2>
                </div>
                <HomeInfoCarouselContainer />
            </div>
        </div>
        <!--Educator and Parents Module-->
        <div
            class="py-70 lg:min-h-400 relative lg:flex lg:items-center lg:justify-center"
            id="educatorModule"
        >
            <div
                class="text-center lg:flex lg:flex-row lg:text-left lg:justify-center lg:gap-40"
                id="educatorContainer"
            >
                <h2
                    class="text-[4.5rem]/[4.5rem] font-extrabold max-w-[90%] m-auto pb-20 text-mainBrand uppercase lg:max-w-400 lg:m-0 lg:text-[6rem]/[5.5rem]"
                >
                    Tools for Parents & Educators
                </h2>
                <div
                    class="m-auto text-[2rem]/[3.5rem] lg:m-0 lg:max-w-625"
                    id="educatorBodyText"
                >
                    <p
                        class="font-bold max-w-[85%] m-auto lg:max-w-full lg:text-[3rem]/[4.5rem] lg:pb-10"
                    >
                        Not sure how to start the conversation?
                    </p>
                    <p class="pb-30 max-w-[85%] m-auto lg:max-w-full lg:pb-6">
                        Use our free resource guides to learn how to start the
                        conversation about deceptive patterns with the people
                        you care about.
                    </p>
                    <div
                        class="flex flex-row justify-center align-top gap-[5%] lg:justify-start"
                    >
                        <img
                            src={rexSticker.src}
                            alt=""
                            class="max-w-100 lg:hidden"
                        />
                        <p class="animate-pulsate">
                            <a
                                class="font-accent text-triggerBrand lowercase p-20 pl-0 hover:underline"
                                href="/under-construction">learn <wbr />more &#62;</a
                            >
                        </p>
                        <img
                            src={racoonSticker.src}
                            alt=""
                            class="max-w-100 lg:hidden"
                        />
                    </div>
                </div>
            </div>
            <!-- <img src={rexRacoonSticker.src} alt="" id="sticker" /> -->
            <div id="rexRacoonSticker"></div>
        </div>
    </main>
</MainLayout>
