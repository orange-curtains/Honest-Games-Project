---
import MainLayout from "../layouts/mainLayout.astro";
import "../styles/global.css";
---

<MainLayout
    metaTitle="About"
    metaDescription="Learn about the creators of the Honest Game Project."
>
    <main class="max-w-[90%] mx-auto lg:max-w-1080">
        <div
            class="bg-[url(https://placehold.co/400x400)] mx-auto mt-50 mb-30 h-300 flex items-end justify-star rounded-2xl shadow-highlight bg-no-repeat bg-cover lg:mb-50"
        >
            <h1
                class="text-heroHead text-secondaryBrand pl-5 lg:text-lgHeroHead lg:pl-25 lg:pb-15"
            >
                About Us
            </h1>
        </div>
        <p class="text-bodySubHead mb-50 lg:mb-70 lg:text-lgBodySubHead">
            By gamers, for gamers, the Honest Games Project is built from the
            ground up to support the people that love games and are tired of the
            aggressive monetization methods distilled throughout the industry.
            Our goal is to educate everyone on the dangers of deceptive patterns
            in video games and advocate for a hobby we can all enjoy without the
            fear of getting coerced into spending more money.
        </p>
        <div class="mb-50 lg:mb-100">
            <div
                class="flex flex-col gap-30 mb-30 lg:flex-row lg:items-center lg:mb-50"
            >
                <div class="order-1">
                    <h2 class="text-bodyHead mb-10 lg:text-lgBodyHead">Alex</h2>
                    <p class="text-bodyCopy lg:text-lgBodyCopy">
                        The creator of the Honest Games Project and an avid cat
                        lover.
                    </p>
                </div>
                <img
                    class="order-0 max-w-350"
                    src="https://placehold.co/400x400"
                />
            </div>
            <div class="flex flex-col gap-30 lg:flex-row lg:items-center">
                <div class="order-1">
                    <h2 class="text-bodyHead mb-10 lg:text-lgBodyHead">Roan</h2>
                    <p class="text-bodyCopy lg:text-lgBodyCopy">
                        The designer behind the Honest Games Project and shreds
                        on the bass.
                    </p>
                </div>
                <img
                    class="order-0 max-w-350"
                    src="https://placehold.co/400x400"
                />
            </div>
        </div>
        <!-- <h2 class="text-heroSubHead mb-15">Our History</h2>
        <p class="mb-50"> 
            The Honest Games Project started in 2022 as an undergraduate capstone project. Since then, it has gone through four iterations, turning it into the website you see today.
        </p> -->
        <div
            class="bg-secondaryBrand rounded-2xl mb-100 text-center shadow-highlight py-50"
        >
            <h2 class="text-heroSubHead mb-15">Get in Touch</h2>
            <p class="mb-30 px-20 lg:max-w-750 lg:mx-auto lg:text-lgBodyCopy">
                Questions? Comments? Inquires? <br />
                Fill out this contact form and we will get in touch.
            </p>
            <a
                href="https://docs.google.com/forms/d/e/1FAIpQLSe5lmZ72_nyDk8h9OQlStBYIEII_DXmpCj4oj94yD3yxGt0Ew/viewform"
                target="_blank"
            >
                <button type="button" class="cta-button">Contact Us</button>
            </a>
        </div>
    </main></MainLayout
>
