---
import MainLayout from "../layouts/mainLayout.astro";
import MainHeroWhiteBG from "../components/mainHeroWhiteBG.astro";
import Main3UpBox from "../components/main3UpBox.astro";
import MainSuperTextCitation from "../components/mainSuperTextCitation.astro";

import "../styles/global.css";
---

<MainLayout metaTitle="Take Action" metaDescription="">
    <main>
        <MainHeroWhiteBG
            mainHeroHeading="Get Informed:"
            mainHeroSubheading="Protect Yourself from Deceptive Patterns in Video Games"
            mainHeroText="Stop video games from using manipulative designs and psychological tricks to spend more money. Whether you are playing a casual mobile game or the latest top seller, understanding deceptive patterns can help you make more informed choices."
        />
        <div
            class="bg-mainBrand min-h-100vh pt-100 pb-50 bg-[url(/assets/game-background-texture.svg)] bg-size-[80rem] xl:min-h-600 xl:bg-size-[150rem]"
            id="quickLinkModule"
        >
            <div
                class="bg-secondaryBrand flex flex-col max-w-[85%] m-auto rounded-3xl shadow-highlight xl:w-800 xl:h-400"
                id="quickLinkContainer"
            >
                <div
                    class="order-1 -mt-50 py-40 text-center xl:text-left xl:order-0 xl:mt-30 xl:pl-40"
                >
                    <h2
                        class="text-[3rem]/[4rem] font-extrabold text-mainBrand uppercase"
                    >
                        Quick Links
                    </h2>
                    <ul class="text-[2.2rem] font-bold">
                        <li class="mb-15 mt-15">
                            <a
                                class="hover:underline focus:underline"
                                href="#common-deceptive-patterns"
                                >Common Deceptive Patterns</a
                            >
                        </li>
                        <li class="mb-15 marker:text-[--linkColor]">
                            <a
                                class="hover:underline focus:underline"
                                href="#real-life-harm">Real Life Harm</a
                            >
                        </li>
                        <li class="mb-15">
                            <a
                                class="hover:underline focus:underline"
                                href="#share-your-story">Share your Story</a
                            >
                        </li>
                    </ul>
                </div>
                <img
                    class="order-0 max-w-[65%] m-auto relative -top-50 rounded-3xl shadow-highlight xl:order-1 xl:-top-275 xl:left-300"
                    src="https://placehold.co/350x330"
                />
            </div>
        </div>

        <div class="my-70 xl:my-100" id="commoneDPModule">
            <h2
                class="uppercase font-extrabold text-mainBrand text-[4rem]/[4.5rem] text-center pb-20 m-auto xl:text-[6rem]/[6.5rem]"
                id="common-deceptive-patterns"
            >
                COMMON DECEPTIVE PATTERNS
            </h2>
            <p
                class="text-[2rem]/[3.2rem] px-30 text-center max-w-desktopWidth m-auto xl:max-w-900"
            >
                Take back control. Learn to recognize deceptive patterns in the
                wild by reading through <a
                    href="/deceptive-patterns"
                    class="text-link hover:underline focus:underline"
                    >our researched deceptive design database</a
                >.
            </p>
            <ul
                class="flex gap-20 mt-60 overflow-x-auto overflow-y-hidden snap-x snap-mandatory lg:overflow-x-hidden lg:flex-wrap lg:max-w-1200 lg:mx-auto xl:justify-center items-start"
            >
                <Main3UpBox
                    threeUpBoxLink="index.html"
                    threeUpBoxTitle="Pay to Win"
                    threeUpBoxText="Money"
                    threeUpBoxImage="https://placehold.co/350x330"
                />
                <Main3UpBox
                    threeUpBoxLink="index.html"
                    threeUpBoxTitle="Grinding"
                    threeUpBoxText="Time"
                    threeUpBoxImage="https://placehold.co/350x330"
                />
                <Main3UpBox
                    threeUpBoxLink="index.html"
                    threeUpBoxTitle="Loot Boxes"
                    threeUpBoxText="Money"
                    threeUpBoxImage="https://placehold.co/350x330"
                />
                <Main3UpBox
                    threeUpBoxLink="index.html"
                    threeUpBoxTitle="Impersonation"
                    threeUpBoxText="Social"
                    threeUpBoxImage="https://placehold.co/350x330"
                />
                <Main3UpBox
                    threeUpBoxLink="index.html"
                    threeUpBoxTitle="Playing by Appointment"
                    threeUpBoxText="Time"
                    threeUpBoxImage="https://placehold.co/350x330"
                />
                <Main3UpBox
                    threeUpBoxLink="index.html"
                    threeUpBoxTitle="Social Pyramid Schemes"
                    threeUpBoxText="Social"
                    threeUpBoxImage="https://placehold.co/350x330"
                />
            </ul>
        </div>

        <div
            class="bg-mainBrand bg-[url(/assets/game-background-texture-bottom.svg)] bg-size-100% bg-no-repeat pt-70 bg-position-[0_-30rem] lg:bg-position-[0_-20rem] lg:pt-100 lg:pb-50 lg:bg-size-[110%] xl:bg-position-[0_-40rem]"
            id="harmModule"
        >
            <div class="max-w-[85%] mx-auto">
                <div
                    class="text-center lg:text-left lg:max-w-1080 lg:mx-auto mb-50"
                >
                    <h2
                        class="uppercase font-extrabold text-[4rem]/[4.5rem] text-secondaryBrand pb-20 lg:text-[6.5rem]/[7rem]"
                        id="real-life-harm"
                    >
                        Real Life Harm
                    </h2>
                    <p
                        class="text-[2rem]/[3.2rem] text-secondaryBrand lg:text-[2.5rem]/[4.5rem]"
                    >
                        Two families lost thousands of dollars.
                        Microtransactions pushed their kids into impulsively
                        spending it. Spending limits could have prevented this.
                    </p>
                </div>
                <ul
                    class="mt-30 pb-30 gap-50 flex flex-col lg:max-w-1080 lg:mx-auto"
                >
                    <li
                        class="flex lg:w-full lg:flex-nowrap lg:p-0 text-secondaryBrand"
                        data-accName="case-study-1"
                    >
                        <div
                            class="text-bodyCopy flex flex-col gap-30 lg:flex-row lg:flex-wrap"
                        >
                            <div
                                class="flex flex-col gap-30 lg:flex-row lg:flex-nowrap lg:items-start lg:overflow-hidden"
                            >
                                <div class="lg:w-2/3 lg:min-h-300">
                                    <h3 class="text-bodyHead font-bold mb-20">
                                        Find out how a young teen lost his
                                        college savings to loot boxes, and why
                                        it was designed to happen
                                    </h3>

                                    <p>
                                        When Johnathon opened his first FIFA
                                        pack at the age of 12, he didn't know he
                                        was gambling. FIFA packs, classified as
                                        loot boxes, offer a small chance to play
                                        his favorite players in-game for
                                        real-world money.<MainSuperTextCitation
                                            citationNumber="1"
                                            citationLink="https://doi.org/10.1016/j.addbeh.2022.107327"
                                            citationText="Spicer, S. G., Fullwood, C., Close, J., Nicklin, L. L., Lloyd, J., & Lloyd, H. (2022). Loot boxes and problem gambling: Investigating the 'Gateway hypothesis.' Addictive Behaviors, 131, 107327."
                                        /> By purchasing them, he was simulating the
                                        highs and lows of real world gambling. The
                                        mechanics of loot boxes are psychological
                                        similar to gambling, and can led vulnerable
                                        players like Johnathon to problem spending--
                                        "...I was addicted to the buzz of chance when
                                        I bought packs."<MainSuperTextCitation
                                            citationNumber="2"
                                            citationLink="https://www.ftc.gov/system/files/documents/reports/staff-perspective-paper-loot-box-workshop/loot_box_workshop_staff_perspective.pdf  "
                                            citationText="FTC Staff Perspective. (2020). FTC Video Game Loot Box Workshop. In FTC.gov. FTC."
                                        />
                                    </p>
                                </div>

                                <div
                                    class="relative self-stretch lg:w-1/3 overflow-hidden"
                                >
                                    <img
                                        class="max-h-[40vh] lg:absolute lg:inset-0 w-full lg:h-full object-cover"
                                        src="https://placehold.co/350x330"
                                        alt=""
                                    />
                                </div>
                            </div>
                            <div>
                                <h4 class="text-bodySubHead font-bold mb-10">
                                    Solutions
                                </h4>
                                <p class="mb-20">
                                    Johnathon is not alone. As long as games
                                    like FIFA employ exploitative monetization
                                    methods, stories like his will continue. The
                                    following changes can help make games safer
                                    for kids to enjoy:
                                </p>
                                <ul class="list-disc list-inside mb-20">
                                    <li>
                                        Get loot boxes labeled for R-18 only
                                    </li>
                                    <li>
                                        Add daily spending limit caps <MainSuperTextCitation
                                            citationNumber="3"
                                            citationLink="https://doi.org/10.1007/s11469-018-0009-3"
                                            citationText="King, D. L., & Delfabbro, P. H. (2018). Video game monetization (e.g., ‘loot boxes’): A blueprint for practical social responsibility measures. International Journal of Mental Health and Addiction, 17(1), 166–179."
                                        />
                                    </li>
                                    <li>
                                        Enable easily accessible spending logs <MainSuperTextCitation
                                            citationNumber="3"
                                            citationLink="https://doi.org/10.1007/s11469-018-0009-3"
                                            citationText="King, D. L., & Delfabbro, P. H. (2018). Video game monetization (e.g., ‘loot boxes’): A blueprint for practical social responsibility measures. International Journal of Mental Health and Addiction, 17(1), 166–179."
                                        />
                                    </li>
                                </ul>
                                <p class="mb-30">
                                    <a
                                        href="https://www.bbc.com/news/business-53337020"
                                        class="text-secondaryBrand underline"
                                        >View the full article on Jonathan's
                                        story on the BBC<svg
                                            class="inline-block mb-10 ml-1"
                                            width="20px"
                                            height="20px"
                                            viewBox="0 0 24 24"
                                            style="cursor:pointer"
                                            ><g
                                                stroke-width="2.1"
                                                stroke="#fffafa"
                                                fill="none"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                ><polyline
                                                    points="17 13.5 17 19.5 5 19.5 5 7.5 11 7.5"
                                                ></polyline><path
                                                    d="M14,4.5 L20,4.5 L20,10.5 M20,4.5 L11,13.5"
                                                ></path></g
                                            ></svg
                                        ></a
                                    >
                                </p>
                            </div>
                        </div>
                    </li>
                    <li
                        class="flex lg:w-full lg:flex-nowrap lg:p-0 text-secondaryBrand"
                        data-accName="case-study-2"
                    >
                        <div
                            class="text-bodyCopy flex flex-col gap-30 lg:flex-row lg:flex-wrap"
                        >
                            <div
                                class="flex flex-col gap-30 lg:flex-row lg:flex-nowrap lg:items-start lg:overflow-hidden"
                            >
                                <div class="lg:w-2/3 lg:min-h-300">
                                    <h3 class="text-bodyHead font-bold mb-15">
                                        Learn how a 10-year-old girl can spend
                                        over £2,500 on in-app purchases and why
                                        it's not her fault
                                    </h3>

                                    <p class="">
                                        Georgina thought her daughter's Roblox
                                        account was compromised by hackers when
                                        she saw the bill. Her 10-year-old child
                                        spent over "£2,500 on the [Roblox]"
                                        through £20 microtransactions. Despite
                                        the claim of unauthorized purchases,
                                        Georgina's requests for refunds from
                                        both Roblox and her bank, Tesco, were
                                        initially denied. Only after the BBC
                                        shared the story did they refund her.
                                    </p>
                                </div>

                                <div
                                    class="relative self-stretch lg:w-1/3 overflow-hidden"
                                >
                                    <img
                                        class="max-h-[40vh] lg:absolute lg:inset-0 w-full lg:h-full object-cover"
                                        src="https://placehold.co/350x330"
                                        alt=""
                                    />
                                </div>
                            </div>
                            <div>
                                <h4 class="text-bodySubHead font-bold mb-10">
                                    Solutions
                                </h4>
                                <p class="mb-20">
                                    Georgina is not the only parent with the rug
                                    pulled from beneath her, yet it is neither
                                    her nor her daughter's fault. We must
                                    examine and criticize the systems in place
                                    that allowed a 10-year-old child to spend
                                    over £2,500 in a month. To prevent more
                                    stories like Georgina's, we can advocate for
                                    the following:
                                </p>
                                <ul class="list-disc list-inside mb-20">
                                    <li>
                                        Default spending limit caps on all kids
                                        games <MainSuperTextCitation
                                            citationNumber="3"
                                            citationLink="https://doi.org/10.1007/s11469-018-0009-3"
                                            citationText="King, D. L., & Delfabbro, P. H. (2018). Video game monetization (e.g., ‘loot boxes’): A blueprint for practical social responsibility measures. International Journal of Mental Health and Addiction, 17(1), 166–179."
                                        />
                                    </li>
                                    <li>
                                        Free and public education on online
                                        safety for both children and parents
                                    </li>
                                    <li>
                                        Consumer's right to refunds for digital
                                        product purchases
                                    </li>
                                </ul>
                                <p class="mb-30">
                                    <a
                                        href="https://www.bbc.com/news/business-53337020"
                                        class="text-secondaryBrand underline"
                                        >View the full article on Jonathan's
                                        story on the BBC<svg
                                            class="inline-block mb-10 ml-1"
                                            width="20px"
                                            height="20px"
                                            viewBox="0 0 24 24"
                                            style="cursor:pointer"
                                            ><g
                                                stroke-width="2.1"
                                                stroke="#fffafa"
                                                fill="none"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                ><polyline
                                                    points="17 13.5 17 19.5 5 19.5 5 7.5 11 7.5"
                                                ></polyline><path
                                                    d="M14,4.5 L20,4.5 L20,10.5 M20,4.5 L11,13.5"
                                                ></path></g
                                            ></svg
                                        ></a
                                    >
                                </p>
                            </div>
                        </div>
                    </li>
                </ul>
                <div
                    class="text-secondaryBrand mx-auto pb-70 text-[1.6rem]/[2.6rem] flex flex-col lg:max-w-1080"
                >
                    <h3 class="text-[2.5rem]/[4.5rem] font-bold">References</h3>
                    <ul class="list-disc list-inside">
                        <li>
                            Bird, N. (2023, May 22). Roblox: Ten-year-old spent
                            £2,500 of Mum’s money without her knowing. BBC News.
                            <a
                                href="https://www.bbc.com/news/uk-wales-65659896"
                                class="text-secondaryBrand underline"
                                >bbc.com/news/uk-wales-65659896<svg
                                    class="inline-block mb-10 ml-1"
                                    width="20px"
                                    height="20px"
                                    viewBox="0 0 24 24"
                                    style="cursor:pointer"
                                    ><g
                                        stroke-width="2.1"
                                        stroke="#fffafa"
                                        fill="none"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        ><polyline
                                            points="17 13.5 17 19.5 5 19.5 5 7.5 11 7.5"
                                        ></polyline><path
                                            d="M14,4.5 L20,4.5 L20,10.5 M20,4.5 L11,13.5"
                                        ></path></g
                                    ></svg
                                ></a
                            >
                        </li>
                        <li>
                            Hannah, F., & Andrews, J. (2020, July 8). Loot
                            boxes: I blew my university savings gaming on FIFA.
                            BBC News. <a
                                href="https://www.bbc.com/news/business-53337020"
                                class="text-secondaryBrand underline"
                                >bbc.com/news/business-53337020<svg
                                    class="inline-block mb-10 ml-1"
                                    width="20px"
                                    height="20px"
                                    viewBox="0 0 24 24"
                                    style="cursor:pointer"
                                    ><g
                                        stroke-width="2.1"
                                        stroke="#fffafa"
                                        fill="none"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        ><polyline
                                            points="17 13.5 17 19.5 5 19.5 5 7.5 11 7.5"
                                        ></polyline><path
                                            d="M14,4.5 L20,4.5 L20,10.5 M20,4.5 L11,13.5"
                                        ></path></g
                                    ></svg
                                ></a
                            >
                        </li>
                        <li>
                            King, D. L., & Delfabbro, P. H. (2018). Video game
                            monetization (e.g., ‘loot boxes’): A blueprint for
                            practical social responsibility measures.
                            International Journal of Mental Health and
                            Addiction, 17(1), 166–179. <a
                                href="https://doi.org/10.1007/s11469-018-0009-3"
                                class="text-secondaryBrand underline"
                                >doi.org/10.1007/s11469-018-0009-3<svg
                                    class="inline-block mb-10 ml-1"
                                    width="20px"
                                    height="20px"
                                    viewBox="0 0 24 24"
                                    style="cursor:pointer"
                                    ><g
                                        stroke-width="2.1"
                                        stroke="#fffafa"
                                        fill="none"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        ><polyline
                                            points="17 13.5 17 19.5 5 19.5 5 7.5 11 7.5"
                                        ></polyline><path
                                            d="M14,4.5 L20,4.5 L20,10.5 M20,4.5 L11,13.5"
                                        ></path></g
                                    ></svg
                                ></a
                            >
                        </li>
                        <li>
                            Spicer, S. G., Fullwood, C., Close, J., Nicklin, L.
                            L., Lloyd, J., & Lloyd, H. (2022). Loot boxes and
                            problem gambling: Investigating the “Gateway
                            hypothesis.” Addictive Behaviors, 131, 107327. <a
                                href="https://doi.org/10.1016/j.addbeh.2022.107327"
                                class="text-secondaryBrand hover:underline"
                                >doi.org/10.1016/j.addbeh.2022.107327<svg
                                    class="inline-block mb-10 ml-1"
                                    width="20px"
                                    height="20px"
                                    viewBox="0 0 24 24"
                                    style="cursor:pointer"
                                    ><g
                                        stroke-width="2.1"
                                        stroke="#fffafa"
                                        fill="none"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        ><polyline
                                            points="17 13.5 17 19.5 5 19.5 5 7.5 11 7.5"
                                        ></polyline><path
                                            d="M14,4.5 L20,4.5 L20,10.5 M20,4.5 L11,13.5"
                                        ></path></g
                                    ></svg
                                ></a
                            >
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div
            class="bg-secondaryBrand max-w-[85%] m-auto px-20 py-40 rounded-2xl text-center lg:max-w-1080 lg:my-50"
            id="shareContainer"
        >
            <h2
                class="font-extrabold text-[3.5rem]/[4rem] mb-20 text-mainBrand lg:mb-30"
                id="share-your-story"
            >
                Share your story with us
            </h2>
            <p
                class="text-[2rem]/[3.5rem] mb-30 lg:max-w-750 lg:mx-auto lg:mb-40"
            >
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
                eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut
                enim ad minim veniam, quis nostrud.
            </p>
            <button class="cta-button">Button</button>
        </div>
    </main>
</MainLayout>

