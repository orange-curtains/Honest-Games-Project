---
const { threeUpBoxLink, threeUpBoxTitle, threeUpBoxText, threeUpBoxImage } =
    Astro.props;
---

<li class="snap-center">
    <a
        href={threeUpBoxLink}
        class="transition-transform duration-250 hover:scale-[1.025] text-copy"
    >
        <div
            class="takeAction3upBox flex flex-col min-w-300 max-w-345 min-h-400 pb-100 lg:min-h-650 bg-secondaryBrand lg:mb-20"
            style="box-shadow: 3px 3px 25px 0px #00000026;"
        >
            <h3 class="order-1 p-20 pb-0 text-[2rem] font-bold">
                {threeUpBoxTitle}
            </h3>
            <p class="order-1 p-20 text-[2rem]/[3.5rem]">{threeUpBoxText}</p>
            <img class="order-0 h-fit" src={threeUpBoxImage} />
        </div>
    </a>
</li>
