---
const { threeUpBoxLink, threeUpBoxTitle, threeUpBoxText, threeUpBoxImage } =
    Astro.props;
---

<li class="snap-center">
    <a href={threeUpBoxLink} class="text-copy">
        <div
            class="takeAction3upBox flex flex-col min-w-300 max-w-345 pb-100 lg:min-h-650 hover-scale bg-secondaryBrand rounded-2xl lg:mb-20"
            style="box-shadow: 3px 3px 25px 0px #00000026;"
        >
            <h3 class="order-1 p-20 pb-0 text-[2rem] font-bold">
                {threeUpBoxTitle}
            </h3>
            <p class="order-1 p-20 text-[2rem]/[3.5rem]">{threeUpBoxText}</p>
            <div class="min-h-200">
                <img
                    class="order-0 h-fit max-w-[60%] mx-auto"
                    src={threeUpBoxImage}
                />
            </div>
        </div>
    </a>
</li>
