---
const {
    carouselHeading,
    carouselText,
    carouselImage,
    carouselLink,
    carouselDataName,
} = Astro.props;
---

<li
    class="px-20 py-35
    flex grow-0 shrink-0 basis-full snap-center
    lg:flex-nowrap lg:basis-auto lg:shrink lg:grow lg:py-0"
    data-accName={carouselDataName}
>
    <div class="flex flex-col lg:flex-row lg:flex-nowrap lg:items-start gap-20">
        <div class="mb-10 order-1 lg:mb-0">
            <h3 class="text-[3rem] font-bold mb-15">{carouselHeading}</h3>
            <p class="text-[2rem]/[3.5rem]">
                {carouselText}
            </p>
        </div>

        <img class="mb-15 object-contain order-0 max-w-350" src={carouselImage} />
    </div>
</li>

