---
const { title, category, description, link, date, tags, author } = Astro.props;
---

<li class={`postBox ${category?.toLowerCase().replaceAll(" ", "-")}`}>
    <a
        href={link}
        class="transition-transform duration-250 hover:scale-[1.025] text-copy"
    >
        <div
            class="flex flex-col py-40 px-40 bg-secondaryBrand shadow-highlight rounded-2xl"
        >
            <h2 class="text-bodyHead text-left w-full order-1 mb-10">
                {title}
            </h2>
            <p class="text-[16px] order-1 mb-10">
                {date} by {author}
            </p>
            <div class="flex flex-wrap gap-5 mb-30 order-1">
                {
                    tags.map((tag: string) => (
                        <span class="bg-mainBrand text-secondaryBrand px-10 py-4 rounded-full text-[1.4rem]/[2rem] min-w-[50px] text-center">
                            {tag}
                        </span>
                    ))
                }
            </div>
            <div
                class="hidden bg-mainBrand rounded-4xl w-[70%] absolute -translate-y-89 shadow-highlight ml-[-20px] lg:w-200"
            >
                <p
                    class="uppercase text-secondaryBrand font-bold text-[2.4rem]/[3.5rem] pl-20 order-0"
                >
                    {category}
                </p>
            </div>
            <hr
                class="order-1 mb-30 w-full border-0 border-t-2 border-[#BFBFBF]"
            />
            <p class="text-bodyCopy order-1">
                {description}
            </p>
        </div>
    </a>
</li>
