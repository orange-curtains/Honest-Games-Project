---
const {
    carouselHeading,
    carouselText,
    carouselImage,
    carouselLink,
    carouselDataName,
} = Astro.props;
---

<li
    class="carousel-slide px-20 py-35 bg-secondaryBrand
    flex grow-0 shrink-0 basis-full snap-center
    lg:flex-nowrap lg:px-60 lg:py-60"
    data-accName={carouselDataName}
    aria-roledescription="slide"
>
    <div class="flex flex-col lg:flex-row lg:flex-nowrap gap-20 lg:gap-40">
        <div class="mb-10 order-1 px-10 lg:mb-0">
            <h3 class="text-[3rem] font-bold mb-15">{carouselHeading}</h3>
            <p class="text-[2rem]/[3.5rem]">
                {carouselText}
            </p>
        </div>

        <img
            class="mb-15 h-fit order-0 lg:mb-30 max-w-400 mx-auto"
            loading="lazy"
            src={carouselImage}
        />
    </div>
</li>

<style>
  
</style>
