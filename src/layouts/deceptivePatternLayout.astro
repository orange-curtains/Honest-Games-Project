---
import MainLayout from "./mainLayout.astro";
import DpGridBox from "../components/dpRelatedGridBox.astro";

import "../styles/global.css";

const { frontmatter } = Astro.props;
---

<style is:global>
    #content p,
    #content ul,
    #content ol {
        font-size: var(--text-lgBodyCopy);
        line-height: 3.2rem;
        font-weight: var(--text-lgBodyCopy--font-weight);
        margin-bottom: 2rem;
    }

    #content ul {
        list-style-type: disc;
        list-style-position: outside;
        padding-left: 2rem;
    }

    #content ol {
        list-style-type: decimal;
        list-style-position: outside;
        padding-left: 2rem;
    }

    #content ol li a, #content span a {
        word-break: break-all;
    }
    
    #dpLayoutMain h1 {
        font-size: var(--text-lgHeroHead);
        line-height: var(--text-lgHeroHead--line-height);
        font-weight: var(--text-lgHeroHead--font-weight);
        margin-bottom: 1rem;
        margin-top: 3rem;
    }
    #content h2 {
        font-size: 5rem;
        line-height: 6rem;
        font-weight: 700;
        margin-bottom: 2rem;
        margin-top: 3rem;
    }
   #content h3 {
        font-size: 3rem;
        line-height: 4rem;
        font-weight: 700;
        margin-bottom: 2rem;
        margin-top: 3rem;
    }
    @media only screen and (max-width: 768px) {
        #dpLayoutMain h1{
            font-size: var(--text-heroHead);
            line-height: var(--text-heroHead--line-height);
        }
        #content h2 {
        font-size: 3rem;
        line-height: 4rem;
        font-weight: 700;
        margin-bottom: 2rem;
        margin-top: 3rem;
    }
   #content h3 {
        font-size: 2rem;
        line-height: 3rem;
        font-weight: 700;
        margin-bottom: 2rem;
        margin-top: 3rem;
    }
        
    }
</style>

<MainLayout
    metaTitle={frontmatter.title}
    metaDescription={frontmatter.description}
>
    <!-- Breadcrumb -->
    <div class="max-w-[85%] mx-auto xl:max-w-1200">
        <hr class="border-mainBrand border-3 xl:mt-50" />
        <div class="mt-50 mb-50 xl:mt-60 xl:mb-75">
            <p class=" text-[1.6rem] lg:text-[2.4rem]/[3.4rem]">
                <a href="/knowledge-base">Knowledge Base</a> / {
                    frontmatter.category.toUpperCase().charAt(0) +
                        frontmatter.category.slice(1)
                } / {frontmatter.title}
            </p>
        </div>
    </div>
    <main id="dpLayoutMain" class="mb-100">
        <div class="max-w-[85%] mx-auto xl:max-w-800">
            <h1>{frontmatter.title}</h1>
            <div class="flex flex-col gap-10 lg:gap-20 mb-20 text-gray-600 lg:flex-row">
            {frontmatter.author && <p class="text-[1.6rem] lg:text-[2rem]">Written by {frontmatter.author}</p>}
            {
                frontmatter.date && (
                    <div class="flex flex-row gap-10 lg:gap-30">
                        <p class="text-[1.6rem] lg:text-[2rem]">Posted: {frontmatter.date}</p>
                        {frontmatter.lastUpdated && (
                            <p class="text-[1.6rem] lg:text-[2rem]">
                                Last updated: {frontmatter.lastUpdated}
                            </p>
                        )}
                    </div>
                )
            }
            </div>
            <div class="mb-100" id="content">
                <slot />
            </div>
        </div>
        <section class="mb-30 xl:mb-50 max-w-[85%] mx-auto xl:max-w-1600">
            <h2 class="text-bodyHead lg:text-lgBodyHead mb-20 max-w-1200 mx-auto">
                Related Deceptive Patterns
            </h2>
            <ul
                class="mx-auto flex flex-col gap-50 py-30 lg:max-w-1600 lg:flex-row lg:flex-wrap lg:gap-35 lg:justify-center lg:mt-30"
            >
                <DpGridBox
                    title={frontmatter.relatedDpTitle1}
                    category={frontmatter.relatedDpCategory1}
                    description={frontmatter.relatedDpDescription1}
                    link={frontmatter.relatedDpLink1}
                />
                <DpGridBox
                    title={frontmatter.relatedDpTitle2}
                    category={frontmatter.relatedDpCategory2}
                    description={frontmatter.relatedDpDescription2}
                    link={frontmatter.relatedDpLink2}
                />
                <DpGridBox
                    title={frontmatter.relatedDpTitle3}
                    category={frontmatter.relatedDpCategory3}
                    description={frontmatter.relatedDpDescription3}
                    link={frontmatter.relatedDpLink3}
                />
            </ul>
        </section>
    </main>
</MainLayout>

<script>
    const citationPopupContainers = document.querySelectorAll<HTMLElement>(
        ".citationPopupContainers",
    );

    // Build a map of citation number -> popup container (first occurrence only)
    const popupMap = new Map<string, HTMLElement>();
    citationPopupContainers.forEach((container) => {
        const num = container.id.replace("citationPopupContainer-", "");
        if (!popupMap.has(num)) {
            popupMap.set(num, container);
        }
    });

    // unique citation popup
    popupMap.forEach((container, citationNumber) => {
        // Find ALL trigger links for this citation number
        const triggers = document.querySelectorAll<HTMLElement>(
            `[data-citation="${citationNumber}"]`,
        );

        triggers.forEach((trigger) => {
            trigger.addEventListener("click", (e) => {
                e.preventDefault();
                container.style.display = "block";
            });
        });

        // Close button inside this container
        container
            .querySelector(".citationPopupCloseBtns")
            ?.addEventListener("click", () => {
                container.style.display = "none";
            });

        // Backdrop inside this container
        container
            .querySelector(".citationPopupBackdrops")
            ?.addEventListener("click", () => {
                container.style.display = "none";
            });
    });
</script>
